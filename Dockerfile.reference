# Reference Dockerfile — compare this against the one you already committed
# to make sure ffmpeg is installed and gunicorn binds to Render's $PORT.

FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Render sets $PORT at runtime; gunicorn must bind to it, not a fixed port.
CMD gunicorn --bind 0.0.0.0:$PORT --workers 2 --timeout 120 app:app
